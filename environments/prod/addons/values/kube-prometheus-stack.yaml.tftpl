# Short resource names: "kps-prometheus", "kps-grafana" ...
fullnameOverride: kps

# GKE runs these control-plane parts itself (we can't scrape them), and
# Dataplane V2 has no kube-proxy. Switch their targets and rules off,
# otherwise Prometheus shows them as permanently DOWN.
kubeControllerManager:
  enabled: false
kubeScheduler:
  enabled: false
kubeEtcd:
  enabled: false
kubeProxy:
  enabled: false
defaultRules:
  rules:
    etcd: false
    kubeControllerManager: false
    kubeSchedulerAlerting: false
    kubeSchedulerRecording: false
    kubeProxy: false

prometheus:
  prometheusSpec:
    retention: 2d
    retentionSize: 8GB
    # Every metric gets these labels, so in the central Grafana (Phase 9)
    # you can always tell which cloud a number came from.
    externalLabels:
      cloud: ${cloud}
      cluster: ${cluster}
    # Pick up monitoring targets from ALL namespaces (e.g. our apps in Phase 7),
    # not only objects created by this chart.
    serviceMonitorSelectorNilUsesHelmValues: false
    podMonitorSelectorNilUsesHelmValues: false
    ruleSelectorNilUsesHelmValues: false
    probeSelectorNilUsesHelmValues: false
    resources:
      requests:
        cpu: 200m
        memory: 1Gi
      limits:
        memory: 2Gi
    storageSpec:
      volumeClaimTemplate:
        spec:
          accessModes: ["ReadWriteOnce"]
          resources:
            requests:
              storage: 10Gi
    # Delete the disk claim (and with it the cloud disk) when Prometheus is
    # uninstalled - otherwise the disk outlives the cluster and costs money.
    persistentVolumeClaimRetentionPolicy:
      whenDeleted: Delete
      whenScaled: Retain

alertmanager:
  alertmanagerSpec:
    resources:
      requests:
        cpu: 20m
        memory: 64Mi
    # The Slack webhook arrives from the vault as the secret
    # "alertmanager-slack" (platform-config) and is mounted as a FILE.
    secrets:
      - alertmanager-slack
  # Who gets told: warning + critical alerts go to Slack (#mern-alerts);
  # info alerts and the always-firing "Watchdog" are dropped.
  # Every alert carries the cloud label (Prometheus externalLabels).
  config:
    global:
      resolve_timeout: 5m
    route:
      receiver: "null"
      group_by: [alertname, cloud, namespace]
      group_wait: 30s
      group_interval: 5m
      repeat_interval: 4h
      routes:
        - receiver: slack
          matchers:
            - severity =~ "warning|critical"
            - alertname !~ "Watchdog|InfoInhibitor"
    inhibit_rules:
      - source_matchers: [severity = "critical"]
        target_matchers: [severity = "warning"]
        equal: [alertname, namespace]
    receivers:
      - name: "null"
      - name: slack
        slack_configs:
          - api_url_file: /etc/alertmanager/secrets/alertmanager-slack/url
            send_resolved: true
            title: '[{{ .Status | toUpper }}] {{ .CommonLabels.alertname }} - {{ .CommonLabels.cloud }}'
            text: |-
              {{ range .Alerts }}*{{ .Labels.severity }}*: {{ .Annotations.summary }}
              {{ .Annotations.description }}
              {{ end }}

# The CENTRAL Grafana: one place for all three clouds.
grafana:
  enabled: true
  defaultDashboardsTimezone: browser
  persistence:
    enabled: false
  # https://grafana.<domain> through the gateway, behind Cloudflare Access.
  grafana.ini:
    server:
      root_url: https://grafana.rishavmukhopadhyay.store
  # CF_ACCESS_CLIENT_ID / CF_ACCESS_CLIENT_SECRET (vault -> ExternalSecret
  # grafana-cf-access): Grafana sends them to the obs-* backends.
  envFromSecret: grafana-cf-access
  sidecar:
    datasources:
      defaultDatasourceEnabled: false # all data sources are listed below
  # Names start with "Prometheus " / "Loki " - the dashboards pick clouds by that.
  # Remote ones: GET only (the obs-* route allows nothing else).
  additionalDataSources:
    - name: Prometheus gcp
      uid: prom-gcp
      type: prometheus
      url: http://kps-prometheus.monitoring.svc:9090
      access: proxy
      isDefault: true
    - name: Prometheus azure
      uid: prom-azure
      type: prometheus
      url: https://obs-azure.rishavmukhopadhyay.store/prom
      access: proxy
      jsonData:
        httpMethod: GET
        httpHeaderName1: CF-Access-Client-Id
        httpHeaderName2: CF-Access-Client-Secret
      secureJsonData:
        httpHeaderValue1: $${CF_ACCESS_CLIENT_ID}
        httpHeaderValue2: $${CF_ACCESS_CLIENT_SECRET}
    - name: Prometheus aws
      uid: prom-aws
      type: prometheus
      url: https://obs-aws.rishavmukhopadhyay.store/prom
      access: proxy
      jsonData:
        httpMethod: GET
        httpHeaderName1: CF-Access-Client-Id
        httpHeaderName2: CF-Access-Client-Secret
      secureJsonData:
        httpHeaderValue1: $${CF_ACCESS_CLIENT_ID}
        httpHeaderValue2: $${CF_ACCESS_CLIENT_SECRET}
    - name: Loki gcp
      uid: loki-gcp
      type: loki
      url: http://loki.monitoring.svc:3100
      access: proxy
    - name: Loki azure
      uid: loki-azure
      type: loki
      url: https://obs-azure.rishavmukhopadhyay.store/loki
      access: proxy
      jsonData:
        httpHeaderName1: CF-Access-Client-Id
        httpHeaderName2: CF-Access-Client-Secret
      secureJsonData:
        httpHeaderValue1: $${CF_ACCESS_CLIENT_ID}
        httpHeaderValue2: $${CF_ACCESS_CLIENT_SECRET}
    - name: Loki aws
      uid: loki-aws
      type: loki
      url: https://obs-aws.rishavmukhopadhyay.store/loki
      access: proxy
      jsonData:
        httpHeaderName1: CF-Access-Client-Id
        httpHeaderName2: CF-Access-Client-Secret
      secureJsonData:
        httpHeaderValue1: $${CF_ACCESS_CLIENT_ID}
        httpHeaderValue2: $${CF_ACCESS_CLIENT_SECRET}

